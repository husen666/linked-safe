#: includes/settings/class-cr-settings-shortcodes.php:169
msgid "%1$s argument accepts %2$s or %3$s and defines if product names will include links to product pages."
msgstr "L‘argument %1$s accepte %2$s ou %3$s et définit si les noms de produits incluront des liens vers les pages des produits."

#: includes/settings/class-cr-settings-shortcodes.php:124
#: includes/settings/class-cr-settings-shortcodes.php:168
msgid "%1$s argument accepts %2$s or %3$s and defines if pictures and names of products corresponding to the review will be shown below the review."
msgstr "L‘argument %1$s accepte %2$s ou %3$s et définit si les images et les noms des produits correspondant à l‘avis seront affichés sous l‘avis."

