msgstr "L‘argument %1$s est un code couleur hexadécimal de la bordure externe autour de la grille d‘avis."

#: includes/settings/class-cr-settings-shortcodes.php:127
#: includes/settings/class-cr-settings-shortcodes.php:171
msgid "%1$s argument defines how reviews are sorted. Possible values are %2$s, %3$s and %4$s."
msgstr "L‘argument %1$s définit la manière dont les avis sont triés. Les valeurs possibles sont %2$s, %3$s et %4$s."

#: includes/settings/class-cr-settings-shortcodes.php:170
msgid "%1$s argument accepts %2$s to sort reviews by date and %3$s to sort reviews by rating."
msgstr "L‘argument %1$s accepte %2$s pour trier les avis par date et %3$s pour trier les avis par évaluation."

