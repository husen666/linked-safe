#: inc/hnf-optin-form.php:445
msgid "Welcome to Headers and Footers"
msgstr "Velkommen til Headers and Footers"

#. Translators: Welcome text
#: inc/hnf-optin-form.php:452
msgid "%1$s Hey %2$s,  %4$s If you opt-in some data about your installation of WP Headers And Footers will be sent to WPBrigade.com (This doesn't include stats)%4$s and You will receive new feature updates, security notifications etc %5$sNo Spam, I promise.%6$s %4$s%4$s Help us %7$sImprove Headers and Footers%8$s %4$s %4$s "
msgstr "%1$s Hej %2$s, %4$s Hvis du tilmelder dig, vil nogle data om din installation af WP Headers And Footers blive sendt til WPBrigade.com (Dette inkluderer ikke statistik)%4$s og du vil modtage nye funktionsopdateringer, sikkerhedsmeddelelser osv. %5$sIngen spam, jeg lover. %6$s %4$s%4$s Hjælp os med at %7$sforbedre sidehoveder og sidefødder%8$s %4$s %4$s "

